# =============================================================================
# Основни настройки на приложението
# =============================================================================

# Име на приложението (UI, имейли, VITE_APP_NAME)
APP_NAME=Laravel

# Среда: local | staging | production
APP_ENV=local

# Криптографски ключ — генерирай с: php artisan key:generate
APP_KEY=

# Режим на отстраняване на грешки (production: false)
APP_DEBUG=true

# URL на приложението (заб.: URL_PREFIX е деривация на APP_URL)
APP_URL=http://localhost

# Домейни, които се считат за stateful за Sanctum
SANCTUM_STATEFUL_DOMAINS=

# Организация, която се използва в приложението
APP_ORGANIZATION=

# Версия на приложението
APP_VERSION=

# Sanctum SPA / API със сесия: Host от браузъра трябва да е в списъка. Ако APP_URL е localhost, а сайтът се отваря през друг домейн (Cloudflare tunnel), добавете го тук.
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,office.avalonbg.com

# Име на организацията / клиента — показва се в навигацията (споделя се чрез Inertia).
APP_ORGANIZATION=

# URL на външен магазин (линк „Магазин“ в хедъра).
APP_SHOP_URL=

# Контактен имейл на началната страница.
APP_CONTACT_EMAIL=home@avalonbg.com

# Основен език на интерфейса
APP_LOCALE=en
# Резервен език при липсващ превод
APP_FALLBACK_LOCALE=en
# Локализация за тестови данни
APP_FAKER_LOCALE=en_US

# =============================================================================
# Поддръжка (maintenance mode)
# =============================================================================

# Драйвер за maintenance: file | database
APP_MAINTENANCE_DRIVER=file

# Брой bcrypt рундове при хеширане на пароли
BCRYPT_ROUNDS=12

# =============================================================================
# Журналиране (logging)
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# База данни (database)
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# Сесии и бисквитки
# =============================================================================

# Драйвер за сесии: database | file | redis
SESSION_DRIVER=database

# Време на живот на сесията (минути)
SESSION_LIFETIME=30

# Бисквитката за сесия само през HTTPS (production: true)
SESSION_SECURE_COOKIE=true

# Криптиране на session payload
SESSION_ENCRYPT=false

# Път на session cookie
SESSION_PATH=/

# Домейн на cookie (null = текущия хост)
SESSION_DOMAIN=null

# =============================================================================
# Файлове, опашки и кеш
# =============================================================================

# Broadcast драйвер (log за локална разработка)
BROADCAST_CONNECTION=log

# Основен filesystem disk: local | public | s3
FILESYSTEM_DISK=local

# Queue драйвер: sync | database | redis
QUEUE_CONNECTION=database

# Cache store: database | file | redis | array
CACHE_STORE=database

# Префикс за cache ключове (по избор)
# CACHE_PREFIX=

# =============================================================================
# Memcached (ако CACHE_STORE=memcached)
# =============================================================================

# Хост на memcached
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# Redis (ако се ползва за cache/queue/session)
# =============================================================================

# Redis PHP клиент: phpredis | predis
REDIS_CLIENT=phpredis

# Redis хост
REDIS_HOST=127.0.0.1

# Redis парола (null ако няма)
REDIS_PASSWORD=null

# Redis порт
REDIS_PORT=6379

# =============================================================================
# Поща (SMTP)
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS S3 опционално — не се ползва
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Frontend (Vite)
# =============================================================================

# Име на приложението във frontend bundle
VITE_APP_NAME="${APP_NAME}"

# Bump after replacing files in public/images/document-types/ (cache bust for SVG icons).
DOCUMENT_ICONS_VERSION=1

# Одит журнал — период на съхранение в години (по подразбиране 1)
AUDIT_LOG_RETENTION_YEARS=1

# Експорт на журнали — 7z архив с парола
SEVEN_ZIP_BINARY=7z
EXPORT_PASSWORD_MIN_LENGTH=8

# Laravel AI SDK (laravel/ai) — add keys for providers you use; see config/ai.php
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
